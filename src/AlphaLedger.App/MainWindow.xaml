<Window x:Class="AlphaLedger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlphaLedger.App"
        xmlns:loc="clr-namespace:AlphaLedger.App.Localization"
        mc:Ignorable="d"
        Title="{DynamicResource AppTitle}"
        Height="780" Width="1240"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="{loc:FlowDirection}"
        loc:LocalizationExtensions.BindFlowDirection="True"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Background="{StaticResource CanvasBrush}"
        Icon="/AlphaLedger.App;component/Resources/AlphaLedger.png">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Header & Application Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area (Sidebar + Workspace) -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Header & Application Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource NavyDarkBrush}" BorderBrush="#0E1D33" BorderThickness="0,0,0,1">
            <Grid Height="50" Margin="14,0">
                <Grid.ColumnDefinitions>
                    <!-- Logo & App Title -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Search & Navigation Tools -->
                    <ColumnDefinition Width="*"/>
                    <!-- User & Settings Bar -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & Titles -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/AlphaLedger.App;component/Resources/AlphaLedger.png"
                           Width="40" Height="40" Margin="0,0,9,0" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource AppShortName}" Foreground="White" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="{DynamicResource AppSubtitle}" Foreground="#B0C4DE" FontSize="11" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Quick Global Search Toolbar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#1E3A5F" CornerRadius="3" BorderBrush="#2E5A88" BorderThickness="1" Height="30" Width="360" Padding="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Foreground="#8FAEC7" FontSize="12" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" x:Name="TopSearchBox"
                                     Text="{Binding QuickSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" Foreground="White"
                                     CaretBrush="White" VerticalContentAlignment="Center" FontSize="12"
                                     KeyDown="TopSearchBox_KeyDown"
                                     ToolTip="{DynamicResource ShellQuickSearchTip}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- User Info & Quick Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Current User Pill -->
                    <Border Background="#1A3353" BorderBrush="#2A4D77" BorderThickness="1" CornerRadius="3" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤 " FontSize="12"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUser}" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentUserRole}" Foreground="#B0C4DE" FontSize="9"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Refresh Button -->
                    <Button Content="🔄" Style="{StaticResource SecondaryButtonStyle}"
                            Click="RefreshCurrentScreen_Click" Width="32" Height="28" Padding="0"
                            ToolTip="{DynamicResource ShellRefreshTip}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Content Area (Sidebar + Workspace) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Right Navigation Sidebar -->
                <ColumnDefinition Width="210"/>
                <!-- Workspace Tabbed Content Area -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource NavyBrush}" BorderBrush="{StaticResource NavyDarkBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <!-- Footer of sidebar (System Info) -->
                    <Border DockPanel.Dock="Bottom" Background="#142846" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource AppFooterBrand}" Foreground="#8C9BA5" FontSize="10.5" FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource ShellOfficeEdition}" Foreground="#657786" FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <!-- Nav Items List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,0,0">
                            <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButtonStyle}"
                                         GroupName="MainNavigation" Content="{DynamicResource NavDashboard}" IsChecked="True" Click="NavDashboard_Click"/>

                            <RadioButton x:Name="NavCompanies" Style="{StaticResource NavButtonStyle}"
                                         GroupName="MainNavigation" Content="{DynamicResource NavCompanies}" Click="NavCompanies_Click"/>
                            <RadioButton x:Name="NavFiscalYears" Style="{StaticResource NavButtonStyle}"
                                         GroupName="MainNavigation" Content="{DynamicResource NavFiscalYears}" Click="NavFiscalYears_Click"/>

                            <RadioButton x:Name="NavOperations" Style="{StaticResource NavButtonStyle}"
                                         GroupName="MainNavigation" Content="{DynamicResource NavOperations}" Click="NavOperations_Click"/>

                            <RadioButton x:Name="NavTaxReturns" Style="{StaticResource NavButtonStyle}"
                                         GroupName="MainNavigation" Content="{DynamicResource NavTaxReturns}" Click="NavTaxReturns_Click"/>

                            <RadioButton x:Name="NavFinancials" Style="{StaticResource NavButtonStyle}"
                                         GroupName="MainNavigation" Content="{DynamicResource NavFinancials}" Click="NavFinancials_Click"/>

                            <RadioButton x:Name="NavArchive" Style="{StaticResource NavButtonStyle}"
                                         GroupName="MainNavigation" Content="{DynamicResource NavArchive}" Click="NavArchive_Click"/>

                            <RadioButton x:Name="NavStaff" Style="{StaticResource NavButtonStyle}"
                                         GroupName="MainNavigation" Content="{DynamicResource NavStaff}" Click="NavStaff_Click"/>

                            <RadioButton x:Name="NavReports" Style="{StaticResource NavButtonStyle}"
                                         GroupName="MainNavigation" Content="{DynamicResource NavReports}" Click="NavReports_Click"/>

                            <Separator Background="#2E5A88" Margin="12,10"/>

                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavButtonStyle}"
                                         GroupName="MainNavigation" Content="{DynamicResource NavSettings}" Click="NavSettings_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Active workspace screen -->
            <Grid Grid.Column="1" Background="#F4F6F8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#E8EDF3" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,0,1" Padding="6,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding OpenTabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="4" Margin="0,0,5,0" Background="White">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#DCEBFA"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Button Content="{Binding Title}" Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="10,5" MinWidth="100"/>
                                                <Button Grid.Column="1" Content="×" Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="7,2" FontSize="15" ToolTip="{DynamicResource CommonClose}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Grid.Column="1" Content="{DynamicResource ShellCloseAllTabs}"
                                Command="{Binding CloseAllTabsCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,3" Margin="6,0,0,0"/>
                    </Grid>
                </Border>
                <ContentControl Grid.Row="1" Content="{Binding ActiveScreen}"/>
            </Grid>
        </Grid>

        <!-- 3. Bottom Status Bar -->
        <Border Grid.Row="2" Background="#EEF2F6" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- DB Status -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <!-- Date & Version -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- DB Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding DatabaseStatus}" FontSize="11.5" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>

                <!-- Current Date and Version -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentDate}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding Version}" FontSize="11" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
