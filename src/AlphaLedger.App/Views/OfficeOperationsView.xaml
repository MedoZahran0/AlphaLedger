<UserControl x:Class="AlphaLedger.App.Views.OfficeOperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:AlphaLedger.App.Localization"
             xmlns:enums="clr-namespace:AlphaLedger.Core.Enums;assembly=AlphaLedger.Core"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="{loc:FlowDirection}"
             loc:LocalizationExtensions.BindFlowDirection="True">
    <Grid Background="#F4F6F8" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{DynamicResource OperationsTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource NavyBrush}"/>
            <TextBlock Text="{DynamicResource OperationsSubtitle}" FontSize="12.5" Foreground="{StaticResource MutedBrush}"/>
            <WrapPanel Margin="0,5,0,0">
                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"><Run Text="{DynamicResource OperationsOverdueCount}"/><Run Text=" "/><Run Text="{Binding OverdueItems.Count, Mode=OneWay}"/></TextBlock>
                <TextBlock Margin="18,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"><Run Text="{DynamicResource OperationsUpcomingCount}"/><Run Text=" "/><Run Text="{Binding UpcomingCount}"/></TextBlock>
            </WrapPanel>
            <WrapPanel Margin="0,5,0,0">
                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding FilterByStatusCommand}" CommandParameter="{x:Static enums:OperationStatus.NotStarted}" Margin="0,0,5,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource OperationsStatusNotStarted}"/><TextBlock Text="{Binding NotStartedCount, StringFormat=' ({0})'}" Margin="4,0,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding FilterByStatusCommand}" CommandParameter="{x:Static enums:OperationStatus.InProgress}" Margin="0,0,5,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource OperationsStatusInProgress}"/><TextBlock Text="{Binding InProgressCount, StringFormat=' ({0})'}" Margin="4,0,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding FilterByStatusCommand}" CommandParameter="{x:Static enums:OperationStatus.WaitingForDocuments}" Margin="0,0,5,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource OperationsStatusWaitingDocuments}"/><TextBlock Text="{Binding WaitingForDocumentsCount, StringFormat=' ({0})'}" Margin="4,0,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding FilterByStatusCommand}" CommandParameter="{x:Static enums:OperationStatus.UnderReview}" Margin="0,0,5,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource OperationsStatusUnderReview}"/><TextBlock Text="{Binding UnderReviewCount, StringFormat=' ({0})'}" Margin="4,0,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding FilterByStatusCommand}" CommandParameter="{x:Static enums:OperationStatus.ReadyForDelivery}" Margin="0,0,5,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource OperationsStatusReadyForDelivery}"/><TextBlock Text="{Binding ReadyForDeliveryCount, StringFormat=' ({0})'}" Margin="4,0,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding FilterByStatusCommand}" CommandParameter="{x:Static enums:OperationStatus.SubmittedOrDelivered}" Margin="0,0,5,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource OperationsStatusSubmitted}"/><TextBlock Text="{Binding SubmittedCount, StringFormat=' ({0})'}" Margin="4,0,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding FilterByStatusCommand}" CommandParameter="{x:Static enums:OperationStatus.Completed}"><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource OperationsStatusCompleted}"/><TextBlock Text="{Binding CompletedCount, StringFormat=' ({0})'}" Margin="4,0,0,0"/></StackPanel></Button>
            </WrapPanel>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <ComboBox MinWidth="180" ItemsSource="{Binding Companies}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedCompanyId, Mode=TwoWay}" Margin="0,0,8,0"/>
            <ComboBox MinWidth="120" ItemsSource="{Binding FiscalYears}" DisplayMemberPath="YearLabel" SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedFiscalYearId, Mode=TwoWay}" ToolTip="{DynamicResource OperationsFiscalYear}" Margin="0,0,8,0"/>
            <TextBox Width="180" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource OperationsSearch}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource CommonRefresh}" Command="{Binding FilterOperationsCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
            <Expander Header="{DynamicResource CommonMoreFilters}" VerticalAlignment="Center">
              <WrapPanel Margin="4,8,4,0">
            <ComboBox MinWidth="150" ItemsSource="{Binding Employees}" DisplayMemberPath="FullName" SelectedValuePath="Id"
                      SelectedValue="{Binding FilterEmployeeId, Mode=TwoWay}" ToolTip="{DynamicResource OperationsEmployeeFilter}" Margin="0,0,8,0"/>
            <ComboBox MinWidth="150" ItemsSource="{Binding FilterStatusOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedFilterStatusOption, Mode=TwoWay}"
                      ToolTip="{DynamicResource OperationsFilterStatus}" Margin="0,0,8,0">
            </ComboBox>
            <CheckBox Content="{DynamicResource OperationsFilterOverdue}" IsChecked="{Binding ShowOverdueOnly}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              </WrapPanel>
            </Expander>
        </WrapPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                  CanUserAddRows="False" SelectionMode="Single" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  Margin="0,0,0,10" Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource CompaniesHeaderName}" Binding="{Binding Company.DisplayName}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource TaxReturnsFiscalYear}" Binding="{Binding FiscalYear.YearLabel}" Width="80"/>
                <DataGridTextColumn Header="{DynamicResource OperationsHeaderCategory}" Binding="{Binding ServiceCategory}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource OperationsHeaderDescription}" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource OperationsAssignedEmployee}" Binding="{Binding AssignedEmployee.FullName}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource OperationsDueDate}" Binding="{Binding DueDate, StringFormat='{}{0:d}'}" Width="110"/>
                <DataGridTextColumn Header="{DynamicResource OperationsStatus}" Binding="{Binding Status, Converter={StaticResource EnumToDisplayConverter}}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="10" Margin="0,0,0,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="{DynamicResource OperationsServiceCategory}"/><TextBox Text="{Binding ServiceCategory, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="2,0,4,0"><TextBlock Text="{DynamicResource OperationsHeaderDescription}"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/></StackPanel>
                        <StackPanel Grid.Column="2" Margin="4,0,2,0"><TextBlock Text="{DynamicResource OperationsDueDate}"/><TextBox Text="{Binding DueDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/></StackPanel>
                        <StackPanel Grid.Column="3" Margin="6,0,0,0"><TextBlock Text="{DynamicResource OperationsStatus}"/><ComboBox ItemsSource="{Binding OperationStatuses}" SelectedItem="{Binding OperationStatus, Mode=TwoWay}" Margin="0,2,0,6"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumToDisplayConverter}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                    </Grid>
                    <Expander Header="{DynamicResource CommonMoreDetails}" Margin="0,2,0,8">
                        <StackPanel Margin="4,6,4,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="{DynamicResource OperationsPriority}"/><ComboBox ItemsSource="{Binding OperationPriorities}" SelectedItem="{Binding OperationPriority, Mode=TwoWay}" Margin="0,2,0,6"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumToDisplayConverter}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                                <StackPanel Grid.Column="1" Margin="2,0,4,0"><TextBlock Text="{DynamicResource OperationsAssignedEmployee}"/><ComboBox ItemsSource="{Binding Employees}" DisplayMemberPath="FullName" SelectedValuePath="Id" SelectedValue="{Binding AssignedEmployeeId}" Margin="0,2,0,6"/></StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,2,0"><TextBlock Text="{DynamicResource OperationsStartDate}"/><TextBox Text="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/></StackPanel>
                                <StackPanel Grid.Column="3" Margin="6,0,0,0"><TextBlock Text="{DynamicResource OperationsAgreedFee}"/><TextBox Text="{Binding AgreedFee, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/></StackPanel>
                            </Grid>
                            <TextBlock Text="{DynamicResource OperationsTaxPeriod}"/>
                            <TextBox Text="{Binding TaxPeriod, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
                            <TextBlock Text="{DynamicResource OperationsNotes}"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
                        </StackPanel>
                    </Expander>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <WrapPanel>
                            <Button Content="{DynamicResource CommonAdd}" Command="{Binding AddOperationCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="{DynamicResource CommonEdit}" Command="{Binding EditOperationCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="{DynamicResource CommonSave}" Command="{Binding SaveEditCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="{DynamicResource OperationsComplete}" Command="{Binding MarkCompleteCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                        </WrapPanel>
                        <Expander Grid.Column="1" Header="{DynamicResource CommonMoreActions}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <WrapPanel Margin="4,6">
                                <Button Content="{DynamicResource OperationsAttachments}" Command="{Binding AttachDocumentCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                                <Button Content="{DynamicResource OperationsCreateFee}" Command="{Binding CreateFeeFromOperationCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                                <Button Content="{DynamicResource ArchiveOpenOnDisk}" Command="{Binding OpenSelectedArchiveCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                                <Button Content="{DynamicResource CommonDelete}" Command="{Binding DeleteOperationCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                            </WrapPanel>
                        </Expander>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="4" Background="#EEF2F6" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource NavyBrush}" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
