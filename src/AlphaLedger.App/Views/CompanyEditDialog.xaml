<Window x:Class="AlphaLedger.App.Views.CompanyEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:AlphaLedger.App.Localization"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="680" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FlowDirection="{loc:FlowDirection}"
         loc:LocalizationExtensions.BindFlowDirection="True"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource NavyBrush}" Padding="18,12">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{DynamicResource CompanyEditDescription}"
                           FontSize="11.5" Foreground="#D6E4F0" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <!-- Alert Banner (Errors / Warnings) -->
                <Border Background="#FDE8E8" BorderBrush="#F98080" BorderThickness="1"
                        Padding="12" Margin="0,0,0,12" CornerRadius="2"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding DuplicateWarning}" Foreground="#9B1C1C"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding DuplicateWarning, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- Section 1: Basic Legal Info -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource CompanyEditSectionBasic}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource CompanyEditLegalNameRequiredLabel}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding LegalNameAr, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{DynamicResource CompanyEditShortName}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource CompanyEditEnglishName}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding EnglishName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{DynamicResource CompanyEditLegalForm}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                <ComboBox Text="{Binding LegalForm, UpdateSourceTrigger=PropertyChanged}" IsEditable="True">
                                    <ComboBoxItem Content="{DynamicResource CompanyEditLegalFormLlc}"/>
                                    <ComboBoxItem Content="{DynamicResource CompanyEditLegalFormSae}"/>
                                    <ComboBoxItem Content="{DynamicResource CompanyEditLegalFormOnePerson}"/>
                                    <ComboBoxItem Content="{DynamicResource CompanyEditLegalFormPartnership}"/>
                                    <ComboBoxItem Content="{DynamicResource CompanyEditLegalFormLimitedPartnership}"/>
                                    <ComboBoxItem Content="{DynamicResource CompanyEditLegalFormSoleProprietorship}"/>
                                    <ComboBoxItem Content="{DynamicResource CompanyEditLegalFormForeignBranch}"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource CompanyEditBusinessActivity}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding BusinessActivity, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Section 2: Tax Details -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource CompanyEditSectionTax}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource CompanyEditTaxDigits}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding TaxRegistrationNumber, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Text="{DynamicResource CompanyEditTaxFileNo}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding TaxFileNumber, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="{DynamicResource CompanyEditRelatedTaxOffice}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding TaxOffice, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 3: Contact Details -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource CompanyEditSectionContact}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource CompanyEditClientAddress}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{DynamicResource CompanyEditPhone}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding PhoneNumbers, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource CompanyEditEmail}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{DynamicResource CompanyEditContactName}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 4: Office Management & Fiscal Year -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource CompanyEditSectionOffice}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource CompanyEditOfficeAccountant}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding Employees}"
                                          SelectedValue="{Binding AssignedEmployeeId, Mode=TwoWay}"
                                          SelectedValuePath="Id" DisplayMemberPath="FullName"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{DynamicResource CompanyEditAddEmployee}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding NewEmployeeName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Archive start year (only when adding) -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10" Margin="0,6,0,8"
                                Visibility="{Binding IsEdit, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{DynamicResource CompanyEditArchiveStartYear}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding ArchiveStartYears}"
                                              SelectedItem="{Binding ArchiveStartYear, Mode=TwoWay}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{DynamicResource CompanyEditArchiveStartYearDescription}"
                                           FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource CompanyEditFeeAgreementLabel}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding FeeAgreementDetails, UpdateSourceTrigger=PropertyChanged}" Height="40" AcceptsReturn="True"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource CompanyEditNotesLabel}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding InternalNotes, UpdateSourceTrigger=PropertyChanged}" Height="40" AcceptsReturn="True"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#EEF2F6" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{DynamicResource CompanyEditSaveData}" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveCommand}" MinWidth="130" Margin="0,0,10,0"/>
                <Button Content="{DynamicResource CompanyEditCancel}" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelCommand}" MinWidth="90"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
