<UserControl x:Class="AlphaLedger.App.Views.ComingSoonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:AlphaLedger.App.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             FlowDirection="{loc:FlowDirection}"
             loc:LocalizationExtensions.BindFlowDirection="True">
    <Grid Background="#F4F6F8">
        <Border Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1"
                CornerRadius="2" Margin="30" Padding="35" HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="650">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="32" Background="#EEF2F6" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="32" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource NavyBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding Details}" FontSize="13" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" Margin="0,0,0,20"/>
                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="14,10" CornerRadius="2">
                    <TextBlock Text="{DynamicResource ComingSoonMessage}"
                               FontSize="12" Foreground="{StaticResource TextBrush}" TextAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
