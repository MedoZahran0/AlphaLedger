<UserControl x:Class="AlphaLedger.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:AlphaLedger.App.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1050"
             FlowDirection="{loc:FlowDirection}"
             loc:LocalizationExtensions.BindFlowDirection="True">
    <Grid Background="#F4F6F8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18">
                <!-- Toolbar / Header -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="16,12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource DashboardTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource NavyBrush}"/>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{DynamicResource DashboardRefresh}" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding LoadCommand}" Margin="0,0,8,0" MinWidth="110"/>
                            <Button Content="{DynamicResource DashboardGoToCompanies}" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding GoToCompaniesCommand}" MinWidth="110"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI Cards Row -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active Companies Card -->
                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="14,12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource DashboardActiveCompanies}" FontSize="12" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ActiveCompanies}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" Margin="0,6,0,4"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}"><Run Text="{DynamicResource DashboardArchivedLabel}"/><Run Text="{Binding ArchivedCompanies}"/></TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Total Fees Card -->
                    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="14,12" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource DashboardTotalFees}" FontSize="12" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/>
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource NavyDarkBrush}" Margin="0,6,0,4"><Run Text="{Binding TotalFees, StringFormat={}{0:N0}}"/><Run Text=" "/><Run Text="{DynamicResource CurrencySymbol}"/></TextBlock>
                            <TextBlock Text="{DynamicResource DashboardFeesScope}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Collections Card -->
                    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="14,12" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource DashboardCollectionsActual}" FontSize="12" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/>
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,4"><Run Text="{Binding TotalCollections, StringFormat={}{0:N0}}"/><Run Text=" "/><Run Text="{DynamicResource CurrencySymbol}"/></TextBlock>
                            <TextBlock FontSize="11" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"><Run Text="{DynamicResource DashboardOutstandingLabel}"/><Run Text="{Binding OutstandingFees, StringFormat={}{0:N0}}"/><Run Text=" "/><Run Text="{DynamicResource CurrencySymbol}"/></TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Overdue & Deadlines Card -->
                    <Border Grid.Column="3" Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="14,12" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource DashboardUpcomingDeadlines}" FontSize="12" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/>
                            <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,4"><Run Text="{Binding OverdueOperations}"/><Run Text=" "/><Run Text="{DynamicResource DashboardOverdueSummary}"/></TextBlock>
                            <TextBlock FontSize="12" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"><Run Text="{Binding UpcomingDeadlines}"/><Run Text=" "/><Run Text="{DynamicResource DashboardUpcomingSummary}"/></TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Data Sections (Two Columns) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Right Column: Recent Companies -->
                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="14" Margin="0,0,6,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource DashboardRecentCompanies}" DockPanel.Dock="Right" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource NavyBrush}"/>
                                <TextBlock Text="{DynamicResource DashboardRecentCompaniesHint}" DockPanel.Dock="Left" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding RecentCompanies}" SelectedItem="{Binding SelectedCompany, Mode=TwoWay}"
                                      MaxHeight="260" MinHeight="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource DashboardColumnCode}" Binding="{Binding Code}" Width="90"/>
                                    <DataGridTextColumn Header="{DynamicResource DashboardColumnCompany}" Binding="{Binding DisplayName}" Width="*"/>
                                    <DataGridTextColumn Header="{DynamicResource DashboardColumnOwner}" Binding="{Binding AssignedEmployeeName}" Width="110"/>
                                    <DataGridTemplateColumn Header="{DynamicResource DashboardColumnStatus}" Width="90">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style><Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{DynamicResource CompaniesStatusActive}"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsArchived}" Value="True"><Setter Property="Text" Value="{DynamicResource CompaniesStatusArchived}"/></DataTrigger></Style.Triggers>
                                                </Style></TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Left Column: Outstanding Collections -->
                    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="14" Margin="6,0,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource DashboardOutstandingTitle}" DockPanel.Dock="Right" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource NavyBrush}"/>
                                <TextBlock Text="{DynamicResource DashboardOutstandingSubtitle}" DockPanel.Dock="Left" FontSize="11" Foreground="{StaticResource DangerBrush}"/>
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding OutstandingCompanies}"
                                      MaxHeight="260" MinHeight="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource DashboardColumnCode}" Binding="{Binding Code}" Width="80"/>
                                    <DataGridTextColumn Header="{DynamicResource DashboardColumnCompany}" Binding="{Binding DisplayName}" Width="*"/>
                                    <DataGridTextColumn Header="{DynamicResource DashboardColumnFees}" Binding="{Binding TotalAgreedFees, StringFormat='{}{0:N0}'}" Width="95"/>
                                    <DataGridTextColumn Header="{DynamicResource DashboardColumnCollected}" Binding="{Binding TotalCollections, StringFormat='{}{0:N0}'}" Width="90"/>
                                    <DataGridTextColumn Header="{DynamicResource DashboardColumnRemaining}" Binding="{Binding RemainingFees, StringFormat='{}{0:N0}'}" Width="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
