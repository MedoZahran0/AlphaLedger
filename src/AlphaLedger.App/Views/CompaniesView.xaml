<UserControl x:Class="AlphaLedger.App.Views.CompaniesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:AlphaLedger.App.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FlowDirection="{loc:FlowDirection}"
             loc:LocalizationExtensions.BindFlowDirection="True">
    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Main Action Toolbar -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,0,1" Padding="12,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{DynamicResource CompaniesAdd}" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddCommand}" Margin="0,0,8,0" MinWidth="130"/>

                <Button Content="{DynamicResource CompaniesEdit}" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding EditCommand}" Margin="0,0,8,0" MinWidth="110"/>

                <Button Content="{DynamicResource CompaniesOpenFolder}" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenFolderCommand}" Margin="0,0,8,0" MinWidth="125"/>

                <Button Content="{DynamicResource CompaniesOpenOnDisk}" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenFolderOnDiskCommand}" Margin="0,0,8,0" MinWidth="125"/>

                <Button Content="{DynamicResource CompaniesLocateFolder}" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding LocateFolderCommand}" Margin="0,0,8,0" MinWidth="125"/>

                <Separator Width="1" Height="22" Background="{StaticResource BorderBrushKey}" Margin="4,0,12,0"/>

                <Button Content="{DynamicResource CompaniesArchive}" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ArchiveCommand}" Margin="0,0,8,0" MinWidth="85"/>

                <Button Content="{DynamicResource CompaniesRestore}" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RestoreCommand}" Margin="0,0,8,0" MinWidth="85"/>

                <Separator Width="1" Height="22" Background="{StaticResource BorderBrushKey}" Margin="4,0,12,0"/>

                <Button Content="{DynamicResource CompaniesExportExcel}" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ExportExcelCommand}" Margin="0,0,8,0" MinWidth="110"/>

                <Button Content="{DynamicResource CompaniesRefresh}" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0" MinWidth="85"/>

                <Button Content="{DynamicResource CommonDelete}" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding DeleteCommand}" Margin="0,0,8,0" MinWidth="85"/>
            </WrapPanel>
        </Border>

        <!-- 2. Filter & Search Bar -->
        <Border Grid.Row="1" Background="#EEF2F6" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{DynamicResource CompaniesSearch}" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{StaticResource NavyBrush}" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Margin="0,0,16,0"
                         ToolTip="{DynamicResource CompaniesSearchTip}"/>

                <TextBlock Grid.Column="2" Text="{DynamicResource CompaniesEmployeeFilter}" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{StaticResource NavyBrush}" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding Employees}"
                          SelectedValue="{Binding SelectedEmployeeId, Mode=TwoWay}"
                          SelectedValuePath="Id" DisplayMemberPath="FullName"
                          Margin="0,0,16,0"/>

                <CheckBox Grid.Column="4" Content="{DynamicResource CompaniesIncludeArchived}"
                          IsChecked="{Binding IncludeArchived, Mode=TwoWay}"
                          VerticalAlignment="Center" FontWeight="SemiBold"
                          Foreground="{StaticResource TextBrush}" Margin="0,0,16,0"/>

                <Button Grid.Column="6" Content="{DynamicResource CompaniesApplyFilter}" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding LoadCommand}" MinWidth="95" Height="28"/>
            </Grid>
        </Border>

        <!-- 3. Companies DataGrid -->
        <DataGrid Grid.Row="2" x:Name="CompaniesGrid"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                  MouseDoubleClick="CompaniesGrid_MouseDoubleClick"
                  PreviewMouseRightButtonDown="CompaniesGrid_PreviewMouseRightButtonDown"
                  Margin="12" Background="White">
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                             FlowDirection="{loc:FlowDirection}" loc:LocalizationExtensions.BindFlowDirection="True">
                    <MenuItem Header="{DynamicResource CompaniesOpenProfile}" Command="{Binding OpenProfileCommand}" FontWeight="Bold"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource CompaniesEdit}" Command="{Binding EditCommand}"/>
                    <MenuItem Header="{DynamicResource CompaniesOpenFolder}" Command="{Binding OpenFolderCommand}"/>
                    <MenuItem Header="{DynamicResource CompaniesOpenOnDisk}" Command="{Binding OpenFolderOnDiskCommand}"/>
                    <MenuItem Header="{DynamicResource CompaniesCreateArchiveFolders}" Command="{Binding CreateArchiveFoldersCommand}"/>
                    <MenuItem Header="{DynamicResource CompaniesLocateFolder}" Command="{Binding LocateFolderCommand}"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource CompaniesArchive}" Command="{Binding ArchiveCommand}"/>
                    <MenuItem Header="{DynamicResource CompaniesRestore}" Command="{Binding RestoreCommand}"/>
                    <MenuItem Header="{DynamicResource CommonDelete}" Command="{Binding DeleteCommand}"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource CompaniesExportExcel}" Command="{Binding ExportExcelCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource CompaniesHeaderCode}" Binding="{Binding Code}" Width="90" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="{DynamicResource CompaniesHeaderName}" Binding="{Binding DisplayName}" Width="160" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="{DynamicResource CompaniesHeaderLegalName}" Binding="{Binding LegalNameAr}" Width="170"/>
                <DataGridTextColumn Header="{DynamicResource CompaniesHeaderTaxRegistration}" Binding="{Binding TaxRegistrationNumber}" Width="130"/>
                <DataGridTextColumn Header="{DynamicResource CompaniesHeaderTaxFile}" Binding="{Binding TaxFileNumber}" Width="120"/>
                <DataGridTextColumn Header="{DynamicResource CompaniesHeaderTaxOffice}" Binding="{Binding TaxOffice}" Width="120"/>
                <DataGridTextColumn Header="{DynamicResource CompaniesHeaderActivity}" Binding="{Binding BusinessActivity}" Width="130"/>
                <DataGridTextColumn Header="{DynamicResource CompaniesEmployeeFilter}" Binding="{Binding AssignedEmployeeName}" Width="120"/>
                <DataGridTextColumn Header="{DynamicResource CompaniesHeaderClientSince}" Binding="{Binding ClientSince, StringFormat='{}{0:d}'}" Width="95"/>
                
                <!-- Status Column -->
                <DataGridTemplateColumn Header="{DynamicResource CompaniesHeaderStatus}" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="2" Padding="6,2" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsArchived}" Value="False">
                                                <Setter Property="Background" Value="#E6F4EA"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                <Setter Property="Background" Value="#FCE8E6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource CompaniesStatusActive}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource CompaniesStatusArchived}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsArchived}" Value="False">
                                                    <Setter Property="Foreground" Value="#137333"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                    <Setter Property="Foreground" Value="#C5221F"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Folder Status Column -->
                <DataGridTemplateColumn Header="{DynamicResource CompaniesHeaderDocumentFolder}" Width="105">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FolderMissing}" Value="False">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FolderMissing}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="11.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource CompaniesFolderAvailable}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FolderMissing}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource CompaniesFolderMissing}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 4. Table Summary Footer -->
        <Border Grid.Row="3" Background="#EEF2F6" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <TextBlock Text="{Binding Status}" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"/>
                <TextBlock Text="{DynamicResource CompaniesTip}"
                           DockPanel.Dock="Left" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
