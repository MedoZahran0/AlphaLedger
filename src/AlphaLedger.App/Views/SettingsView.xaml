<UserControl x:Class="AlphaLedger.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:AlphaLedger.App.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             FlowDirection="{loc:FlowDirection}"
             loc:LocalizationExtensions.BindFlowDirection="True">
    <Grid Background="#F4F6F8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" MaxWidth="850" HorizontalAlignment="Stretch">
                <!-- Header -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="20,16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource NavyBrush}"/>
                            <TextBlock Text="{DynamicResource SettingsSubtitle}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource SettingsSave}" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveCommand}" MinWidth="130" Height="32"/>
                    </Grid>
                </Border>

                <!-- Document Root Card -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsDocumentRoot}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource SettingsDocumentRootDesc}"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DocumentRoot, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="{DynamicResource SettingsBrowse}" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding BrowseCommand}" MinWidth="120"/>
                        </Grid>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" CornerRadius="2">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SettingsStandardStructure}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource NavyDarkBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="{DynamicResource SettingsFolderStructure}"
                                           FontSize="11.5" Foreground="{StaticResource MutedBrush}" LineHeight="18"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- User Identity Card -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsIdentity}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource SettingsIdentityDesc}"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource SettingsIdentityName}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding CurrentUserName, UpdateSourceTrigger=PropertyChanged}" FontSize="13" MaxWidth="360" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource SettingsIdentityRole}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding CurrentUserRole, UpdateSourceTrigger=PropertyChanged}" FontSize="13" MaxWidth="360" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Language Card -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsLanguage}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource SettingsLanguageDesc}"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource SettingsLanguageLabel}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      FontSize="13" Height="32" MaxWidth="320" HorizontalAlignment="Right">
                                <ComboBoxItem Tag="en-US" Content="{DynamicResource LanguageEnglish}"/>
                                <ComboBoxItem Tag="ar-EG" Content="{DynamicResource LanguageArabic}"/>
                            </ComboBox>
                        </Grid>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Padding="10,8" Margin="0,12,0,0" CornerRadius="2">
                            <TextBlock Text="{DynamicResource SettingsLanguageDirectionHint}"
                                       FontSize="11.5" Foreground="#1D4ED8" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- System Info Card -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsSystemInfo}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,12"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource SettingsDatabasePath}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" Background="#F8FAFC" FontSize="12"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource SettingsAppDataPath}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding AppDataPath, Mode=OneWay}" IsReadOnly="True" Background="#F8FAFC" FontSize="12"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource SettingsSystemStatus}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12.5" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsUpdatesTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource SettingsUpdatesDescription}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="{DynamicResource SettingsCheckForUpdates}"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="170"
                                    Margin="12,0,0,0"/>
                            <TextBlock Text="{Binding UpdateStatus}"
                                       FontSize="12.5"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
