<UserControl x:Class="AlphaLedger.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:AlphaLedger.App.Localization"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             FlowDirection="{loc:FlowDirection}"
             loc:LocalizationExtensions.BindFlowDirection="True">
    <Grid Background="#F4F6F8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14" MaxWidth="1200" HorizontalAlignment="Stretch">
                <Border Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource SettingsTitle}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource NavyBrush}"/>
                            <TextBlock Text="{DynamicResource SettingsSubtitle}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource SettingsSave}" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveCommand}" MinWidth="120" Height="30"/>
                    </Grid>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsDocumentRoot}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,3"/>
                        <TextBlock Text="{DynamicResource SettingsDocumentRootDesc}"
                                   FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DocumentRoot, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12.5" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="{DynamicResource SettingsBrowse}" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding BrowseCommand}" MinWidth="110" Height="30"/>
                        </Grid>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="9,6" CornerRadius="2">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SettingsStandardStructure}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource NavyDarkBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="{DynamicResource SettingsFolderStructure}"
                                           FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsIdentity}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,3"/>
                            <TextBlock Text="{DynamicResource SettingsIdentityDesc}"
                                       FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource SettingsIdentityName}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding CurrentUserName, UpdateSourceTrigger=PropertyChanged}" FontSize="12" MaxWidth="360" HorizontalAlignment="Stretch" Height="28"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource SettingsIdentityRole}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding CurrentUserRole, UpdateSourceTrigger=PropertyChanged}" FontSize="12" MaxWidth="360" HorizontalAlignment="Stretch" Height="28"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsLanguage}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,3"/>
                            <TextBlock Text="{DynamicResource SettingsLanguageDesc}"
                                       FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource SettingsLanguageLabel}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                                          SelectedValuePath="Tag" FontSize="12" Height="29" MinWidth="150">
                                    <ComboBoxItem Tag="en-US" Content="{DynamicResource LanguageEnglish}"/>
                                    <ComboBoxItem Tag="ar-EG" Content="{DynamicResource LanguageArabic}"/>
                                </ComboBox>
                            </Grid>
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Padding="8,5" Margin="0,8,0,0" CornerRadius="2">
                                <TextBlock Text="{DynamicResource SettingsLanguageDirectionHint}"
                                           FontSize="10.5" Foreground="#1D4ED8" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsPasswordTitle}" FontSize="13.5"
                                   FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource SettingsPasswordDescription}" FontSize="11.5"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource SettingsCurrentPasswordLabel}" FontWeight="SemiBold"
                                       FontSize="11.5" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="CurrentPasswordBox" Grid.Column="1" Height="29"
                                         MaxWidth="360" HorizontalAlignment="Left" Padding="7,4"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource SettingsNewPasswordLabel}" FontWeight="SemiBold"
                                       FontSize="11.5" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="NewPasswordBox" Grid.Column="1" Height="29"
                                         MaxWidth="360" HorizontalAlignment="Left" Padding="7,4"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource SettingsConfirmPasswordLabel}" FontWeight="SemiBold"
                                       FontSize="11.5" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="ConfirmNewPasswordBox" Grid.Column="1" Height="29"
                                         MaxWidth="360" HorizontalAlignment="Left" Padding="7,4"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{DynamicResource SettingsChangePasswordButton}"
                                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="145"
                                    Height="30" Click="ChangePassword_Click"/>
                            <TextBlock Text="{Binding PasswordStatus}" FontSize="11.5"
                                       Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsSystemInfo}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource SettingsDatabasePath}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" Background="#F8FAFC" FontSize="10.5" Height="27"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource SettingsAppDataPath}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding AppDataPath, Mode=OneWay}" IsReadOnly="True" Background="#F8FAFC" FontSize="10.5" Height="27"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource SettingsSystemStatus}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsUpdatesTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,3"/>
                            <TextBlock Text="{DynamicResource SettingsUpdatesDescription}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        Content="{DynamicResource SettingsCheckForUpdates}"
                                        Command="{Binding CheckForUpdatesCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="150" Height="30"
                                        Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding UpdateStatus}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="#10243E" BorderBrush="#1E3A5F" BorderThickness="1"
                        Padding="16,12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsCopyright}" FontSize="12.5"
                                   FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="{DynamicResource SettingsContactTitle}" FontSize="11"
                                   Foreground="#B0C4DE" Margin="0,4,0,6"/>
                        <TextBlock FontSize="12.5">
                            <Run Text="● " Foreground="#25D366"/>
                            <Hyperlink NavigateUri="https://wa.me/201095247005"
                                       RequestNavigate="WhatsAppLink_RequestNavigate">
                                <Run Text="{DynamicResource SettingsWhatsAppContact}" Foreground="#7EE2A8"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
