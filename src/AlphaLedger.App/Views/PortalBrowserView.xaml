<UserControl x:Class="AlphaLedger.App.Views.PortalBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AlphaLedger.App.Localization"
             FlowDirection="{loc:FlowDirection}"
             loc:LocalizationExtensions.BindFlowDirection="True">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,0,1" Padding="8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="←" ToolTip="Back" Click="Back_Click" Style="{StaticResource SecondaryButtonStyle}" MinWidth="44" Margin="0,0,6,0"/>
                <Button Content="→" ToolTip="Forward" Click="Forward_Click" Style="{StaticResource SecondaryButtonStyle}" MinWidth="44" Margin="0,0,6,0"/>
                <Button Content="⟳" ToolTip="Refresh" Click="Refresh_Click" Style="{StaticResource SecondaryButtonStyle}" MinWidth="44"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Browser" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"/>
            <Border x:Name="RuntimeUnavailablePanel" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel MaxWidth="520">
                    <TextBlock x:Name="RuntimeUnavailableText" Text="{DynamicResource PortalRuntimeUnavailable}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,1,0,0" Padding="10,5">
            <TextBlock x:Name="StatusText" Text="{DynamicResource PortalManualSignIn}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
        </Border>
    </Grid>
</UserControl>
