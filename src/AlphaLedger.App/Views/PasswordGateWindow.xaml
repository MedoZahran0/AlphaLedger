<Window x:Class="AlphaLedger.App.Views.PasswordGateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AlphaLedger.App.Localization"
        Title="{DynamicResource AppLockWindowTitle}"
        Width="900" Height="580" MinWidth="900" MinHeight="580"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#EDF1F6"
        FlowDirection="{loc:FlowDirection}"
        loc:LocalizationExtensions.BindFlowDirection="True"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#10203A" Offset="0"/>
            <GradientStop Color="#1B365D" Offset="0.55"/>
            <GradientStop Color="#2E5A88" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="GatePasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1F2933"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"
                                          Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2E5A88"/>
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GatePrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource NavyBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavyDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="18" Background="White" CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="3" Opacity="0.16" Color="#1B365D"/>
            </Border.Effect>
        </Border>

        <Border Margin="18" Background="White" CornerRadius="18"
                BorderBrush="#E1E8F0" BorderThickness="1">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Form panel -->
            <Grid Grid.Column="0" Margin="48,38,48,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="{DynamicResource AppLockTitle}"
                               FontSize="25" FontWeight="Bold"
                               Foreground="{StaticResource NavyBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="SubtitleText" Text="{DynamicResource AppLockLoginSubtitle}"
                               Margin="0,8,0,0" FontSize="13.5" LineHeight="22"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{DynamicResource AppLockPasswordLabel}"
                               Margin="0,26,0,8" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <PasswordBox x:Name="PasswordInput" Style="{StaticResource GatePasswordBox}"
                                 KeyDown="PasswordInput_KeyDown"/>
                    <TextBlock Text="{DynamicResource AppLockPasswordHint}"
                               Margin="0,7,0,0" FontSize="11.5"
                               Foreground="#7B8794" TextWrapping="Wrap"/>

                    <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed" Margin="0,16,0,0">
                        <TextBlock Text="{DynamicResource AppLockConfirmPasswordLabel}"
                                   Margin="0,0,0,8" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <PasswordBox x:Name="ConfirmPasswordInput" Style="{StaticResource GatePasswordBox}"
                                     KeyDown="PasswordInput_KeyDown"/>
                    </StackPanel>

                    <Border x:Name="ErrorPanel" Visibility="Collapsed"
                            Margin="0,18,0,0" Padding="12,10" CornerRadius="9"
                            Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1">
                        <TextBlock x:Name="ErrorText" FontSize="12.5" LineHeight="19"
                                   Foreground="#B42318" TextWrapping="Wrap"/>
                    </Border>

                    <Button x:Name="ContinueButton" Margin="0,24,0,0" Height="48"
                            Style="{StaticResource GatePrimaryButton}"
                            Content="{DynamicResource AppLockLoginButton}"
                            Click="ContinueButton_Click"/>
                </StackPanel>

                <!-- Footer: copyright + WhatsApp contact -->
                <StackPanel Grid.Row="1" Margin="0,22,0,0">
                    <Border Height="1" Background="#E7ECF2" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource SettingsCopyright}"
                                   FontSize="11.5" Foreground="#8A96A3"/>
                        <TextBlock Text="•" FontSize="11.5" Foreground="#C3CCD6" Margin="8,0"/>
                        <Border Background="#E6F7EF" CornerRadius="9" Padding="10,5"
                                VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink NavigateUri="https://wa.me/201095247005"
                                           RequestNavigate="WhatsAppLink_RequestNavigate"
                                           Foreground="#128C7E" TextDecorations="None"
                                           FontWeight="SemiBold" Cursor="Hand">
                                    <Run Text="&#xE717;" FontFamily="Segoe MDL2 Assets"/>
                                    <Run Text="  "/>
                                    <Run Text="{DynamicResource SettingsWhatsAppContact}"/>
                                </Hyperlink>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Brand panel -->
            <Border Grid.Column="1" Margin="6" CornerRadius="13"
                    Background="{StaticResource BrandGradient}">
                <Grid Margin="34,38,34,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <Border Width="62" Height="62" CornerRadius="18"
                                HorizontalAlignment="Left" Background="#2EFFFFFF">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="27" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Alpha Ledger" Margin="0,22,0,0"
                                   FontSize="27" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{DynamicResource AppLockBrandTagline}"
                                   Margin="0,10,0,0" FontSize="13.5" LineHeight="23"
                                   Foreground="#C6D7EA" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="1" Padding="14,12" CornerRadius="11"
                            Background="#1FFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                        <TextBlock FontSize="12" LineHeight="20" Foreground="#DCE8F5"
                                   TextWrapping="Wrap">
                            <Run Text="&#xE72E;  " FontFamily="Segoe MDL2 Assets" Foreground="#9FC0E4"/>
                            <Run Text="{DynamicResource AppLockBrandSecurity}"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
