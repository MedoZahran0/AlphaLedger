<Window x:Class="AlphaLedger.App.Views.PasswordGateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AlphaLedger.App.Localization"
        Title="{DynamicResource AppLockWindowTitle}"
        Width="430" Height="360" MinWidth="430" MinHeight="360"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{loc:FlowDirection}"
        loc:LocalizationExtensions.BindFlowDirection="True">
    <Grid Background="#F3F6FA">
        <Border Background="White" Margin="22" Padding="24"
                BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{DynamicResource AppLockTitle}" FontSize="20"
                               FontWeight="Bold" Foreground="{StaticResource NavyBrush}"/>
                    <TextBlock x:Name="SubtitleText" Text="{DynamicResource AppLockLoginSubtitle}"
                               Margin="0,6,0,0" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,18,0,12">
                    <TextBlock Text="{DynamicResource AppLockPasswordLabel}" FontWeight="SemiBold"
                               FontSize="12.5" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PasswordInput" Height="36" Padding="8,5"
                                 FontSize="14" KeyDown="PasswordInput_KeyDown"/>
                    <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="{DynamicResource AppLockConfirmPasswordLabel}" FontWeight="SemiBold"
                                   FontSize="12.5" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="ConfirmPasswordInput" Height="36" Padding="8,5"
                                     FontSize="14" KeyDown="PasswordInput_KeyDown"/>
                    </StackPanel>
                    <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="#B42318"
                               FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>

                <Button x:Name="ContinueButton" Grid.Row="2"
                        Content="{DynamicResource AppLockLoginButton}"
                        Style="{StaticResource PrimaryButtonStyle}" Height="38"
                        Click="ContinueButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
