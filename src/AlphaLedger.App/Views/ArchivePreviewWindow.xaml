<Window x:Class="AlphaLedger.App.Views.ArchivePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview" Height="700" Width="900" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ToolBar Grid.Row="0">
            <Button Content="Fit" Click="Fit_Click"/>
            <Button Content="+" Click="ZoomIn_Click"/>
            <Button Content="-" Click="ZoomOut_Click"/>
        </ToolBar>
        <Grid Grid.Row="1" x:Name="ContentHost"/>
    </Grid>
</Window>