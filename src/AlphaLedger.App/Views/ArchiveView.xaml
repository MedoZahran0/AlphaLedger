<UserControl x:Class="AlphaLedger.App.Views.ArchiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AlphaLedger.App.Localization"
             xmlns:vm="clr-namespace:AlphaLedger.App.ViewModels"
             xmlns:local="clr-namespace:AlphaLedger.App.Views"
             FlowDirection="{loc:FlowDirection}"
             loc:LocalizationExtensions.BindFlowDirection="True"
             AllowDrop="True" PreviewKeyDown="ArchiveView_PreviewKeyDown" Focusable="True">
    <UserControl.Resources>
        <local:BoolToToggleConverter x:Key="BoolToToggleConverter"/>
    </UserControl.Resources>
    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,0,1" Padding="10,6">
            <WrapPanel>
                <Button Content="←" ToolTip="{DynamicResource ArchiveBack}" Command="{Binding NavigateBackCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"/>
                <Button Content="→" ToolTip="{DynamicResource ArchiveForward}" Command="{Binding NavigateForwardCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"/>
                <Button Content="{DynamicResource ArchiveOpenOnDisk}" ToolTip="{DynamicResource ArchiveOpenOnDisk}" Command="{Binding OpenCompanyArchiveOnDiskCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"/>
                <Button Content="{DynamicResource ArchiveAdd}" ToolTip="{DynamicResource ArchiveAddFiles}" Command="{Binding AddFilesCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0"/>
                <Button Content="{DynamicResource ArchiveNewFolder}" Command="{Binding CreateFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"/>
                <Button Content="{DynamicResource ArchiveNewMainFolder}" Command="{Binding CreateMainFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"/>
                <Button Content="{DynamicResource ArchiveDelete}" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"/>
                <Button Content="{DynamicResource ArchiveTrash}" Command="{Binding ShowTrashCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"/>
                <Menu VerticalAlignment="Center">
                    <MenuItem Header="{DynamicResource ArchiveMore}">
                        <MenuItem Header="{DynamicResource ArchiveOpen}" Command="{Binding OpenFileCommand}" CommandParameter="{Binding SelectedFile}"/>
                        <MenuItem Header="{DynamicResource ArchiveRename}" Command="{Binding RenameCommand}" CommandParameter="{Binding SelectedFile}"/>
                        <MenuItem Header="{DynamicResource ArchiveCopy}" Command="{Binding CopySelectedCommand}"/>
                        <MenuItem Header="{DynamicResource ArchiveMove}" Command="{Binding MoveSelectedDialogCommand}"/>
                        <MenuItem Header="{DynamicResource ArchiveRestore}" Command="{Binding RestoreSelectedCommand}"/>
                        <MenuItem Header="{DynamicResource ArchivePermanentDelete}" Command="{Binding PermanentDeleteCommand}"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource ArchiveFiles}" Command="{Binding ShowFilesCommand}"/>
                        <MenuItem Header="{DynamicResource ArchiveRefresh}" Command="{Binding RefreshCommand}"/>
                    </MenuItem>
                </Menu>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="8,0,0,0" ToolTip="{DynamicResource ArchiveSearch}"/>
                <CheckBox Content="{DynamicResource ArchiveSearchAll}" IsChecked="{Binding SearchAllFolders}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>
        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                <TextBlock Text="{DynamicResource ArchiveSelectYear}" FontWeight="SemiBold" Margin="2,0,0,4"/>
                <ListBox ItemsSource="{Binding TreeNodes}"
                         SelectedItem="{Binding SelectedYearNode, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="14,7"/>
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="TabBorder"
                                                Background="White"
                                                BorderBrush="{StaticResource BorderBrushKey}"
                                                BorderThickness="1"
                                                CornerRadius="4,4,0,0"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource NavyBrush}"/>
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource NavyBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource NavyBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" MinWidth="42" TextAlignment="Center"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Margin="0,0,8,0">
                <TreeView ItemsSource="{Binding SelectedYearNode.Children}" SelectedItemChanged="FolderTree_SelectedItemChanged" BorderThickness="0">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:ArchiveFolderNode}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsYear}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Code, StringFormat=' ({0})'}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,0"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="FolderItem_PreviewMouseRightButtonDown"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="{DynamicResource ArchiveOpen}" Command="{Binding NavigateIntoFolderCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="{DynamicResource ArchiveNewFolder}" Command="{Binding CreateSubfolderCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="{DynamicResource ArchiveRename}" Command="{Binding RenameFolderCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="{DynamicResource ArchiveDelete}" Command="{Binding DeleteFolderCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="{DynamicResource ArchiveRestore}" Command="{Binding RestoreFolderCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.Resources>
                </TreeView>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="8,4" Text="{Binding SelectedFolder.FullPath}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" SelectionMode="Extended" SelectionChanged="DataGrid_SelectionChanged" MouseDoubleClick="DataGrid_MouseDoubleClick" PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{DynamicResource ArchiveAddFiles}" Command="{Binding AddFilesCommand}"/>
                                <MenuItem Header="{DynamicResource ArchiveNewFolder}" Command="{Binding CreateFolderCommand}"/>
                                <Separator/>
                                <MenuItem Header="{DynamicResource ArchiveRefresh}" Command="{Binding RefreshCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{DynamicResource ArchiveOpen}" Command="{Binding OpenFileCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="{DynamicResource ArchiveNewFolder}" Command="{Binding CreateSubfolderCommand}" CommandParameter="{Binding PlacementTarget.DataContext.FolderNode, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="{DynamicResource ArchiveRename}" Command="{Binding RenameCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="{DynamicResource ArchiveCopy}" Command="{Binding CopySelectedCommand}"/>
                                            <MenuItem Header="{DynamicResource ArchiveMove}" Command="{Binding MoveSelectedDialogCommand}"/>
                                            <MenuItem Header="{DynamicResource ArchiveDelete}" Command="{Binding DeleteSelectedCommand}"/>
                                            <MenuItem Header="{DynamicResource ArchiveRestore}" Command="{Binding RestoreSelectedCommand}"/>
                                            <MenuItem Header="{DynamicResource ArchivePermanentDelete}" Command="{Binding PermanentDeleteCommand}"/>
                                            <MenuItem Header="{DynamicResource ArchivePreview}" Command="{Binding PreviewCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{DynamicResource ArchiveName}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="FolderGlyph" Text="📁" Margin="0,0,5,0" Visibility="Collapsed"/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                <Setter TargetName="FolderGlyph" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource ArchiveFolder}" Binding="{Binding FolderName}" Width="120"/>
                            <DataGridTextColumn Header="{DynamicResource ArchiveType}" Binding="{Binding Extension}" Width="70"/>
                            <DataGridTextColumn Header="{DynamicResource ArchiveSize}" Binding="{Binding SizeText}" Width="90"/>
                            <DataGridTextColumn Header="{DynamicResource ArchiveCreated}" Binding="{Binding CreatedAt}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#EEF2F6" Padding="12,4">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
        </Border>
    </Grid>
</UserControl>
