<Window x:Class="AlphaLedger.App.Views.UpdateNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AlphaLedger.App.Localization"
        Title="{DynamicResource UpdateNotesTitle}"
        Width="590" Height="500" MinWidth="500" MinHeight="400"
        ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FlowDirection="{loc:FlowDirection}"
        loc:LocalizationExtensions.BindFlowDirection="True">
    <Grid Background="#F3F6FA">
        <Border Background="White" Margin="20" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="#10243E" Padding="24,20" CornerRadius="8,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource UpdateNotesTitle}" FontSize="21"
                                   FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="VersionText" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="#7EE2A8" Margin="0,8,0,0"/>
                        <TextBlock Text="{DynamicResource UpdateNotesSubtitle}" FontSize="12"
                                   Foreground="#C5D3E2" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="22,16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ChangesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="•" Foreground="#15966A" FontSize="16"
                                                   FontWeight="Bold" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13"
                                                   Foreground="#26364A" TextWrapping="Wrap" LineHeight="20"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="NoChangesText" Text="{DynamicResource UpdateNotesNoDetails}"
                               Visibility="Collapsed" FontSize="13" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Top" TextWrapping="Wrap"/>
                </Grid>

                <Border Grid.Row="2" BorderBrush="#E7EDF4" BorderThickness="0,1,0,0" Padding="20,12">
                    <Button Content="{DynamicResource UpdateNotesClose}" Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="110" Height="34" HorizontalAlignment="Right" Click="CloseButton_Click"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
