<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="NavyColor">#1B365D</Color>
    <Color x:Key="NavyDarkColor">#12243F</Color>
    <Color x:Key="AccentColor">#2E5A88</Color>
    <Color x:Key="SelectionColor">#D6E4F0</Color>
    <Color x:Key="BorderColor">#C5CDD6</Color>
    <Color x:Key="CanvasColor">#F4F6F8</Color>
    <Color x:Key="TextColor">#1F2933</Color>
    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource NavyColor}"/>
    <SolidColorBrush x:Key="NavyDarkBrush" Color="{StaticResource NavyDarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="BorderBrushKey" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5B6770"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#9B1C1C"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#1F7A4D"/>
</ResourceDictionary>
